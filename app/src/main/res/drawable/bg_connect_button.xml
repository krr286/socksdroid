<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Внешнее кольцо -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#7A3FF7"
                android:endColor="#3A1A9E"
                android:angle="135"
                android:type="radial"
                android:gradientRadius="180" />
            <stroke android:width="2dp" android:color="#9A6FFF" />
        </shape>
    </item>
    <!-- Внутренний тёмный круг -->
    <item android:left="16dp" android:right="16dp" android:top="16dp" android:bottom="16dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#3A1A9E"
                android:endColor="#1A0F2E"
                android:angle="135" />
            <stroke android:width="2dp" android:color="#7A3FF7" />
        </shape>
    </item>
</layer-list>
